# Variables de entorno para Quizzes Automáticos (Sistema Modular con Votación)

# ─── ACTIVACIÓN DE QUIZZES ────────────────────────────────────────
# Para activar los quizzes automáticos, establece en "true"
QUIZ_ENABLED=true

# ─── CONFIGURACIÓN DE FRECUENCIA ───────────────────────────────────
# Cuántos quizzes automáticos por día (recomendado: 2-4)
QUIZ_DAILY_COUNT=3

# ─── DÍAS DE QUIZZES ───────────────────────────────────────────────
# Días de la semana para quizzes automáticos
# 0=domingo, 1=lunes, 2=martes, 3=miércoles, 4=jueves, 5=viernes, 6=sábado
# Por defecto: lunes a viernes (1,2,3,4,5)
QUIZ_DAYS=1,2,3,4,5

# ─── RANGO HORARIO ─────────────────────────────────────────────────
# Hora de inicio (formato 24h) - por defecto 10 AM
QUIZ_START_HOUR=10

# Hora de fin (formato 24h) - por defecto 10 PM
QUIZ_END_HOUR=22

# ─── TIEMPO DE RESPUESTA ─────────────────────────────────────────────
# Tiempo límite para responder quizzes (en segundos)
# Valores recomendados: 5-15 segundos
QUIZ_TIME_LIMIT=10

# ─── CONFIGURACIÓN DE VOTACIÓN ─────────────────────────────────────
# Porcentaje del grupo necesario para aprobar un quiz (0.05 = 5%)
QUIZ_THRESHOLD=0.05

# ─── CONFIGURACIÓN DE API EXTERNA ───────────────────────────────────
# Para activar preguntas desde API externa (Open Trivia Database)
QUIZ_API_ENABLED=true

# URL de la API de preguntas (Open Trivia DB por defecto)
QUIZ_API_URL=https://opentdb.com/api.php

# Timeout para peticiones a la API (milisegundos)
QUIZ_API_TIMEOUT=5000

# Usar banco local como fallback si la API falla
QUIZ_API_FALLBACK=true

# ─── CONFIGURACIÓN DE NAVEGADOR ───────────────────────────────────────
# Tipo de navegador para WhatsApp Web
BROWSER_TYPE=firefox

# ─── EJEMPLOS DE CONFIGURACIÓN ────────────────────────────────────
# 
# Opción 1: Solo banco local, votación 5%
# QUIZ_ENABLED=true
# QUIZ_API_ENABLED=false
# QUIZ_THRESHOLD=0.05
# QUIZ_DAILY_COUNT=3
# QUIZ_TIME_LIMIT=10
#
# Opción 2: API externa, votación 10%
# QUIZ_ENABLED=true
# QUIZ_API_ENABLED=true
# QUIZ_THRESHOLD=0.10
# QUIZ_DAILY_COUNT=2
# QUIZ_TIME_LIMIT=15
#
# Opción 3: Solo admins pueden iniciar (umbral alto)
# QUIZ_ENABLED=true
# QUIZ_THRESHOLD=0.50
# QUIZ_DAILY_COUNT=4
# QUIZ_TIME_LIMIT=8
#
# Opción 4: Desactivado
# QUIZ_ENABLED=false
